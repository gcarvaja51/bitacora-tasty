
.env

.claude/
.scratch/
debug.log
gamma_refresh_log.txt
informe_trade_log.txt
premercado_auto_log.txt
gamma_daemon/node_modules/
gamma_daemon/status.json
gamma_daemon/history.json
gamma_daemon/sigma_profile/
# Perfil propio de la captura de niveles (2026-08-25). Mismo motivo que el de
# arriba: guarda la SESION de Sigma Terminal. Se creo el 24-ago para separar el
# navegador de la captura del navegador del daemon y no se habia ignorado, asi
# que el primer commit que lo tocara se llevaba 1936 archivos y las cookies.
gamma_daemon/captura_profile/
gamma_daemon/daemon_crash_log.txt

# Cache de Python (scripts/ y skills/)
__pycache__/
*.pyc

# Salida generada por scripts/analisis_spx.py — se regenera corriendo el script
# y cambia en cada corrida, asi que versionarla solo ensucia los diffs. El .py
# si va versionado: es la fuente.
scripts/informe_analisis_spx.md

# Impuestos — datos fiscales personales. NO deben salir del equipo:
# gastos deducibles, otros ingresos, dependientes y pérdidas compensables.
impuestos_gastos.json
impuestos_config.json
impuestos_perdidas.json
trm_cache.json

# Volcados de depuracion de sesiones de analisis (89MB, no son fuente)
.scratch_*

# Cierres diarios del Contador (Fase 1) — salida generada, no fuente.
# El motor es scripts/cierre_diario.py y se puede rehacer con --dias N.
cierres/

# Veredictos del Auditor (Fase 2) — salida generada, no fuente.
veredictos/

# Calidad del dato y analisis (Fase 3) — salida generada, no fuente.
datos/

# Vigilancia intradia (Fase 4) — salida generada, no fuente.
vigilancia/

# Deriva y actas (Fase 5) — salida generada, no fuente.
deriva/
actas/

# Trabajo temporal de sesiones de analisis — se regenera, no es fuente.
.tmp_*/
.tmp_*.json
.tmp_*.txt

# Copias de seguridad puntuales antes de reescribir un archivo. La version
# buena es la que esta versionada; el .bak solo sirve durante el cambio.
*.bak_20*
gamma_daemon/live_source.bak.txt

# Logs y estado de runtime (misma familia que gamma_daemon/status.json,
# ya ignorado arriba): cambian solos y ensucian todos los diffs.
gamma_daemon/watchdog.log
gamma_daemon/watchdog_state.json
gamma_daemon/daemon_stdout.log
scripts/revision_reversion.log

# Scratch de analisis de una sola vez (2026-08-25). Se acumularon 36 archivos
# —_estudio_*, _mp_*, _analisis_*— de estudios puntuales que ya cumplieron y que
# nadie referencia: verificado con una pasada por el repo, los skills y la carpeta
# de estrategias, cero menciones. Quedan en el historial de git por si hicieran
# falta. El prefijo _ marca "de usar y tirar"; que no vuelvan al arbol.
_*.js
_*.py
_*.json
_*.txt
_*.mjs
_*.cmd
!_fix_symbol.mjs
!_fix_sigma_spx.mjs
# _abrir_captura.cmd queda FUERA del arbol a proposito: lleva la ruta absoluta
# del Chromium de puppeteer, que cambia con cada version. Se regenera cuando
# haga falta re-loguear el perfil de la captura.

# Volcados de una sesion de diagnostico (2026-08-31). `*_tmp.json` son respuestas
# crudas de produccion guardadas para mirarlas con jq; los `.log`/`_salida.txt`/
# `_stderr.txt` del collector y los PNG de escenarios son salida generada, no
# fuente. 1,4 MB que no aportan nada al historial y ensucian cada `git status`.
*_tmp.json
premercado_collector/*.log
premercado_collector/*_salida.txt
premercado_collector/*_stderr.txt
escenarios_*.png
spx_30m_*.png
# Copia de seguridad de un cambio en curso. Misma razon que `*.bak_20*`: la buena
# es la que esta versionada.
*.bak_rueda_*
